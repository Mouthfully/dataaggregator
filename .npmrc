# Workspace packages are always linked from the workspace, never fetched from a registry.
link-workspace-packages=true
prefer-workspace-packages=true
resolution-mode=highest

# Peers are installed automatically, but a genuine peer conflict must FAIL the install
# rather than warn. This is what actually catches the vitest 4-vs-5 trap: with
# strict-peer-dependencies=false a bad bump installs cleanly and only surfaces later as
# "no tests found". Verified: setting the catalog to vitest 5.0.0 now fails `pnpm install`.
auto-install-peers=true
strict-peer-dependencies=true
