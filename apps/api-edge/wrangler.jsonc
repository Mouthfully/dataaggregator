{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-edge",
  "main": "src/index.ts",

  // Capped at the OLDER of the two workerd binaries in this workspace, not the newer one.
  // wrangler 4.129.0 bundles workerd 1.20260903.1, but @cloudflare/vitest-pool-workers
  // 0.22.0 pulls miniflare 5.20260815.0-alpha whose workerd supports dates only up to
  // 2026-08-22. A later date typechecks and deploys but fails every test with
  // ERR_RUNTIME_FAILURE. Raise this only when the pool's miniflare catches up.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // The scheduled half (docs/marketplane/28-cron-and-retention.md). Delivery every minute, because
  // a restatement detected during a nightly backfill should not wait for morning; the prune daily,
  // at an arbitrary minute rather than on the hour; and the ingest sweep daily, which is the one
  // that makes the product's "every morning" mean anything.
  //
  // THE INGEST INTERVAL IS A CLOUDFLARE CONSTRAINT, NOT A PREFERENCE. CPU per Cron Trigger is 30
  // seconds for an interval UNDER one hour and 15 minutes for an interval of one hour or more
  // (developers.cloudflare.com/workers/platform/limits). A sweep opens a sealed credential, pages a
  // merchant's store and writes envelope rows; under an hour it would be killed mid-run with a
  // lease held. See INGEST_CRON in src/scheduled.ts.
  //
  // ALL THREE STRINGS ARE DUPLICATED IN src/, and that duplication is checked rather than trusted,
  // in BOTH directions: a test asserts every cron here is dispatched AND every cron dispatched
  // appears here. Wrangler cannot import a TypeScript constant and this file is the only place
  // Cloudflare reads.
  "triggers": {
    "crons": ["* * * * *", "17 3 * * *", "23 2 * * *"]
  },

  // Verbatim raw platform payloads (00-repo-map.md section 5). The binding exists here because
  // @repo/payloads has to be tested against a REAL R2 implementation: the property it guarantees is
  // that a large payload never enters the isolate, and a fake bucket that accepts a stream cannot
  // demonstrate that. @cloudflare/vitest-pool-workers gives miniflare's real R2 for this binding.
  "r2_buckets": [
    {
      "binding": "PAYLOADS",
      "bucket_name": "payloads",
      "preview_bucket_name": "payloads-preview"
    }
  ]
}
