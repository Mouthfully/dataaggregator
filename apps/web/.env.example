# Sign-in. Both are PUBLIC -- they ship to every browser that loads the app, and they are not
# secrets. What protects a tenant's data is row-level security: an anon key with no session reaches
# no row at all, which 20260911000100_anon_has_nothing.sql asserts.
#
# THE SERVICE-ROLE KEY MUST NEVER APPEAR HERE OR IN THIS APP. It bypasses every policy in the
# schema, so one import of it into a route would turn a bug in that route into a cross-tenant read.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<the project's anon / publishable key>

# Optional. Overrides the site URL used for absolute links and for the OAuth callback. Leave unset
# on Vercel: siteUrl() already prefers the per-deployment URL, so a preview advertises itself.
# PUBLIC_SITE_URL=https://example.com

# Billing. SERVER ONLY -- none of these may gain a NEXT_PUBLIC_ prefix.
# STRIPE_SECRET_KEY can create charges and read every customer.
STRIPE_SECRET_KEY=sk_test_...
# What proves an inbound webhook is Stripe's. Without it, anyone who learns the URL can grant
# themselves a plan. From `stripe listen` locally, or the endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=whsec_...
# The billing webhook writes tables that deliberately have no tenant write policy, so it cannot
# use a session. This is the ONLY place in the app that holds this key.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Price ids differ between Stripe's test and live modes, so there is no default safe in both.
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_GROWTH_MONTHLY=price_...
STRIPE_PRICE_GROWTH_YEARLY=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...
STRIPE_PRICE_AGENCY_YEARLY=price_...

# PRE-LAUNCH GATE. Set this and the whole site redirects to /waitlist until a visitor enters it;
# unset and the site is simply public, with no other change. It is a shared password with no
# per-person identity -- a curtain that keeps an unfinished product off the open web, NOT an access
# control. The signed-in routes have their own, through Supabase Auth and row-level security.
#
# The cookie holds an HMAC of a fixed label under this password, never the password, so rotating it
# invalidates every cookie already issued with nothing to revoke.
SITE_PASSWORD=<any string; changing it logs everyone out of the preview>
