{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Same reasoning as @repo/oauth and @repo/webhooks: this package uses globals that BOTH target
    // runtimes provide -- fetch, Response, URL, URLSearchParams, TextEncoder, btoa, atob,
    // crypto.subtle -- and that `lib: ["ES2022"]` alone declares none of. "DOM" is the smallest lib
    // that declares them all, it is used HERE ONLY, and it does not leak to consumers because
    // internal packages ship raw TypeScript compiled under the consumer's tsconfig.
    //
    // So this standalone check is the WEAKER of the two. The real proof is that the package is
    // imported from apps/api-edge and typechecks there under @cloudflare/workers-types with no DOM
    // lib at all -- which is also the only place the structural match against `PerformanceStore`
    // and `Authenticator` is checked, because those interfaces live in the app and a package
    // cannot import them.
    "lib": ["ES2022", "DOM"],
    "types": [],
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
