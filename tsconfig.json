{
  // The WORKSPACE ROOT's own TypeScript: `scripts/*.ts`.
  //
  // The eight `check-*.mjs` guards are deliberately NOT here. They are plain JavaScript with no
  // workspace imports so that CI can run them with bare `node` even when install is half-broken,
  // which is exactly when a guard is most worth having.
  //
  // The operator scripts are the opposite case. `seal-connection.ts` performs envelope encryption
  // and builds a credential the Worker must be able to open; it imports @repo/vault, @repo/connections
  // and @repo/connectors precisely so that no second copy of any of that exists. Types are what hold
  // it to those contracts, so it must be checked -- and `pnpm -r` skips the workspace root, which is
  // why the root `typecheck` script runs this config before recursing.
  // WHY "DOM" IS HERE, given that tsconfig.base.json warns against merging runtime libs.
  //
  // That warning is about mixing DOM with @cloudflare/workers-types, where whichever declaration of
  // fetch/Request/Response wins leaves code typechecking against the wrong runtime. There are no
  // workers types here, so there is nothing to clash with.
  //
  // These scripts run in NODE, whose globals are `fetch`, `Response`, `crypto.subtle`, `CryptoKey`
  // and `SubtleCrypto` -- the WHATWG set, which "DOM" is the declaration of. @repo/store's jwt.ts
  // names `SubtleCrypto` and `CryptoKey` as ambient globals and leaves the consumer to supply them;
  // apps/api-edge supplies them through the workers types, and this is the Node equivalent. Without
  // it the root typecheck fails on a package that is correct.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["scripts/**/*.ts"]
}
